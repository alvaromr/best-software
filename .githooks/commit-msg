#!/bin/sh
# The convention: references/git.md, "Messages".
message=$(grep -v '^#' "$1")
subject=$(printf '%s\n' "$message" | sed -n 1p)
second=$(printf '%s\n' "$message" | sed -n 2p)
fail() { echo "commit-msg: $1: $subject" >&2; exit 1; }
# wc -m counts characters in every shell; ${#subject} counts bytes in some, such as dash.
[ "$(printf '%s' "$subject" | wc -m)" -le 72 ] || fail "the subject passes 72 characters"
case $subject in [[:upper:]]*) ;; *) fail "the subject starts without a capital letter" ;; esac
case $subject in *.) fail "the subject ends with a period" ;; esac
case $subject in *:*) case ${subject%%:*} in *' '*) ;; *) fail "the subject has a prefix" ;; esac ;; esac
[ -z "$second" ] || fail "the subject is not followed by a blank line"
